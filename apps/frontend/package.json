{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:ci": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2"
  },
  "jest": {
    "testRegex": "/test/.*\\.spec\\.ts$",
    "moduleNameMapper": { "^@/(.*)$": "<rootDir>/$1" },
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "jsx": "react-jsx", "module": "commonjs", "moduleResolution": "node", "isolatedModules": true } }]
    }
  }
}
